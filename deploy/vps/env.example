# Copied to /etc/omnistat/omnistat.env by setup.sh (mode 0640, never overwritten).
# After editing: sudo systemctl restart omnistat-api

# Comma-separated server-side API keys; the frontend sends one as X-API-Key.
# setup.sh generates a random value on first run.
OMNISTAT_API_KEYS=change-me

# Natural-language features
GROQ_API_KEY=
HF_MODEL_REPO=BenedictBett/omnistat-intent-classifier
HF_TOKEN=

# Limits (defaults shown); sandboxes themselves are enabled in the systemd unit.
R_MAX_CONCURRENT=4
R_CPU_SECONDS=30
R_MEMORY_MB=2048
MATH_MAX_CONCURRENT=4
MATH_MEMORY_MB=1024
